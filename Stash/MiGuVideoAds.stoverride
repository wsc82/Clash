name: 咪咕视频去广告
desc: |
  如果有需要的去除广告的APP，可自行在共享表格中添加需求
  从圈叉重写自动转换为 Stash 覆写。源: https://ddgksf2013.top/rewrite/MiGuVideoAds.conf
  如需引用请注明出处，谢谢合作！
author: '@ddgksf2013'
homepage: 'https://ddgksf2013.top/rewrite/MiGuVideoAds.conf'
category: 去广告
# source: https://ddgksf2013.top/rewrite/MiGuVideoAds.conf

http:
  mitm:
    - '*.miguvideo.com'
    - '*.migu.cn'

  url-rewrite:
    - 'https://.*miguvideo\.com\/request\/sdk - reject-200'
    - 'https://.*miguvideo\.com\/deliver\/site\/batchMatch\/mergeSpot\/miguvideo - reject-200'

  body-rewrite:
    - 'https://.*miguvideo\.com\/recommend-dynamic\/dataSource\/v\d\/recommend response-jq .body.data=[]'
    - 'https://.*migu\.cn\/search\/hotword response-jq .body={}'

  script:
    - match: 'https://.*miguvideo\.com\/app-management\/v\d\/staticcache\/navigation-list\/miguvideo\/ios'
      name: migu.ads
      type: response
      require-body: true
      timeout: 30
    - match: 'https://.*miguvideo\.com\/display\/v\d\/static\/PERSONAL_CENTER'
      name: migu.ads
      type: response
      require-body: true
      timeout: 30

script-providers:
  migu.ads:
    url: https://ddgksf2013.top/scripts/migu.ads.js
    interval: 86400
