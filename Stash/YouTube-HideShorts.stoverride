name: YouTube 去广告 + 隐藏 Shorts
desc: 由 Aioneas 的 Surge 模块 youtube.aioneas.hide-shorts 手动改写为 Stash 覆写。需要先在 Stash 里装好并信任 MitM 证书。
author: DivineEngine + app2smile + Maasea + ddgksf2013 + Aioneas
homepage: https://github.com/Aioneas/Surge
icon: https://raw.githubusercontent.com/Aioneas/Surge/main/Icon/YouTube.png
category: 去广告

http:
  mitm:
    - "-redirector*.googlevideo.com"
    - "*.googlevideo.com"
    - www.youtube.com
    - s.youtube.com
    - youtubei.googleapis.com

  url-rewrite:
    # 视频广告请求
    - (^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
    - ^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject-200
    # 通用广告请求
    - ^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
    - ^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
    - ^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

  script:
    - match: ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)
      name: youtube.response
      type: response
      require-body: true
      binary-mode: true
      timeout: 60
      argument: '{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":false,"blockShorts":true,"debug":false}'

script-providers:
  youtube.response:
    url: https://raw.githubusercontent.com/Aioneas/Surge/main/Script/youtube.response.js
    interval: 86400

# 拦掉 YouTube 的 QUIC（UDP），让它回落到 TCP，这样 MitM 才能生效
rules:
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
  - AND,((DOMAIN-SUFFIX,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT
